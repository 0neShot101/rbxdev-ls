{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode"],
      "preLaunchTask": "build-all",
      "outFiles": ["${workspaceFolder}/packages/vscode/out/**/*.js"]
    }
  ]
}
