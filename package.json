{
  "name": "rbxdev-ls-workspace",
  "version": "0.3.6",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/server build",
    "build:mcp": "bun run --cwd packages/mcp build",
    "build:all": "bun run --cwd packages/server build && bun run build:mcp",
    "start": "bun run --cwd packages/server start",
    "start:mcp": "bun run --cwd packages/mcp start",
    "dev": "bun run --cwd packages/server dev",
    "dev:mcp": "bun run --cwd packages/mcp dev",
    "clean": "bun run --cwd packages/server clean",
    "lint": "eslint packages/server/src --ext .ts --fix",
    "lint:check": "eslint packages/server/src --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit -p packages/server/tsconfig.json",
    "test": "bun test --cwd packages/server && bun test --cwd packages/mcp",
    "fetch-api": "bun scripts/fetch-roblox-api.ts",
    "build:vsix": "bun scripts/build-vsix.ts",
    "build:beta": "bun scripts/build-vsix.ts --beta",
    "build:bridge": "bun packages/luau-bundler/src/cli.ts --src roblox/executor-bridge/src --out scripts/executor-bridge.lua --header 'rbxdev executor bridge'",
    "build:studio": "bun scripts/build-studio-plugin.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "3.1.3"
    },
    "eslint-plugin-import": {
      "minimatch": "3.1.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    }
  }
}
