{
  "name": "@0neshot101/rbxdev-mcp",
  "version": "0.3.6",
  "description": "MCP server for connecting AI tools (Claude, Cursor, etc.) to live Roblox game instances",
  "main": "dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "bin": {
    "rbxdev-mcp": "./dist/index.js"
  },
  "type": "module",
  "files": [
    "dist/index.js",
    "README.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "rbxdev-server": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "roblox",
    "mcp",
    "model-context-protocol",
    "luau",
    "lua",
    "claude",
    "cursor",
    "ai",
    "game",
    "executor",
    "language-server"
  ],
  "author": "Andrew",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0neShot101/rbxdev-ls",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/0neShot101/rbxdev-ls#mcp-server",
  "bugs": {
    "url": "https://github.com/0neShot101/rbxdev-ls/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
