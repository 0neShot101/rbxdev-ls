{
  "name": "@oneshot101/rbxdev-mcp",
  "version": "0.4.9",
  "description": "MCP server for connecting AI tools (Claude, Cursor, etc.) to live Roblox game instances",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "rbxdev-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist/index.js",
    "dist/server.js",
    "types",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun build src/index.ts src/server.ts --outdir dist --target node",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "rbxdev-server": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/bun": "latest",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "roblox",
    "mcp",
    "model-context-protocol",
    "luau",
    "lua",
    "claude",
    "cursor",
    "ai",
    "game",
    "executor",
    "language-server"
  ],
  "author": "Andrew",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0neShot101/rbxdev-ls.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/0neShot101/rbxdev-ls#mcp-server",
  "bugs": {
    "url": "https://github.com/0neShot101/rbxdev-ls/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
