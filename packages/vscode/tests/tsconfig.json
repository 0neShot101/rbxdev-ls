{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "bun"],
    "paths": {
      "#extension/*": ["../src/*"],
      "@extension/*": ["../src/*"],
      "@typings/*": ["../src/types/*"],
      "@tests/*": ["./*"]
    }
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
