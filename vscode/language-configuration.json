{
  "comments": {
    "lineComment": "--",
    "blockComment": ["--[[", "]]"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "[[", "close": "]]", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*--\\s*#?region\\b",
      "end": "^\\s*--\\s*#?endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "\\b(then|do|repeat|else)\\s*(--.*)?$|function\\s*\\([^)]*\\)\\s*(--.*)?$|\\{\\s*$|\\[\\s*$",
    "decreaseIndentPattern": "^\\s*(end|else|elseif|until)\\b|^\\s*\\}|^\\s*\\]"
  },
  "onEnterRules": [
    {
      "beforeText": "\\b(then|do)\\s*(--.*)?$",
      "afterText": "^\\s*(end|else|elseif)\\b",
      "action": { "indentAction": "indentOutdent" }
    },
    {
      "beforeText": "\\brepeat\\s*(--.*)?$",
      "afterText": "^\\s*until\\b",
      "action": { "indentAction": "indentOutdent" }
    },
    {
      "beforeText": "function\\s*\\([^)]*\\)\\s*(--.*)?$",
      "afterText": "^\\s*end\\b",
      "action": { "indentAction": "indentOutdent" }
    }
  ],
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*"
}
